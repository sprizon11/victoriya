# --- secrets ---
# .env holds JWT_SECRET, admin credentials and the Mongo connection string.
.env
*.env.bak
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!*.env.example

# --- python ---
backend/.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
backend/memory/

# --- node ---
node_modules/
frontend/build/
npm-debug.log*
yarn-error.log*

# --- editors / os ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

