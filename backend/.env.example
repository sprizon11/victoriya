# Copy to .env and fill in. NEVER commit the real .env - it is gitignored.
#
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ---- database ----
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL="mongodb://localhost:27017"
DB_NAME="victoria_unit_flow"

# ---- auth ----
# Must be unique per deployment. Changing it invalidates all sessions.
JWT_SECRET="CHANGE_ME_run_the_command_above"

# First admin account, created on first boot only.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME"

# Set to true ONLY if you are locked out: forces the admin password back to
# ADMIN_PASSWORD on next boot. Turn it off again afterwards.
ADMIN_PASSWORD_RESET="false"

# ---- deployment mode ----
# true  = hosted/public: HTTPS cookies, no API docs, refuses weak secrets
# false = local development
PUBLIC_MODE="false"

# Browser origins allowed to call the API. Leave EMPTY in production, where this
# process serves the frontend itself. Only needed when running the React dev
# server separately, e.g. http://localhost:3000
CORS_ORIGINS="http://localhost:3000"

# ---- optional overrides ----
# COOKIE_SECURE="false"        # follows PUBLIC_MODE unless set
# COOKIE_SAMESITE="lax"
# FRONTEND_BUILD_DIR="../frontend/build"
# MEMORY_DIR="./memory"
